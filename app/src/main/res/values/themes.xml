<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wirl" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSurface">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
    </style>

    <style name="Theme.Wirl.Translucent" parent="Theme.Wirl">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- A settings card: filled surface, rounded, flat. -->
    <style name="Widget.Wirl.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- The body of a settings card: 20dp inside, with the same 12dp gap between every item. -->
    <style name="Wirl_CardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
        <item name="android:showDividers">middle</item>
        <item name="android:divider">@drawable/space_12</item>
    </style>

    <!-- A switch row inside a card. -->
    <style name="Wirl_Row" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <!-- Helper text under a control. -->
    <style name="Wirl_Caption">
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- Settings: a dark screen in Manrope. The rest of the app keeps the light theme. -->
    <style name="Theme.Wirl.Settings" parent="Theme.Wirl">
        <item name="colorPrimary">@color/settings_accent</item>
        <item name="colorOnPrimary">@color/settings_bg</item>
        <item name="colorSecondary">@color/settings_accent</item>
        <item name="colorSurface">@color/settings_bg</item>
        <item name="colorOnSurface">@color/settings_text</item>
        <item name="colorOnSurfaceVariant">@color/settings_text_secondary</item>
        <item name="android:colorBackground">@color/settings_bg</item>
        <item name="android:statusBarColor">@color/settings_bg</item>
        <item name="android:navigationBarColor">@color/settings_bg</item>
        <item name="textAppearanceTitleLarge">@style/Wirl.TextAppearance.Title</item>
        <item name="textAppearanceTitleMedium">@style/Wirl.TextAppearance.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/Wirl.TextAppearance.Body</item>
        <item name="textAppearanceBodyMedium">@style/Wirl.TextAppearance.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/Wirl.TextAppearance.Caption</item>
        <item name="textAppearanceLabelLarge">@style/Wirl.TextAppearance.BodyMedium</item>
    </style>

    <!-- Type scale for Settings: sizes are kept small enough that a line of text fits on one row on a phone. -->
    <style name="Wirl.TextAppearance.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Wirl.TextAppearance.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="Wirl.TextAppearance.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Wirl.TextAppearance.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Wirl.TextAppearance.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- A settings card: dark surface with a 1dp border, rounded. -->
    <style name="Widget.Wirl.Settings.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/settings_card</item>
        <item name="strokeColor">@color/settings_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
</resources>
