<?xml version="1.0" encoding="utf-8"?>
<!-- One paired computer on the Computer sync screen: name, status line, Sync now, Pair again, Unpair. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Wirl.Settings.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/computerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/settings_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/computerSyncing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                android:contentDescription="@string/syncing"
                app:indicatorSize="18dp"
                app:trackThickness="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/computerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/settings_text_secondary"
            android:textSize="13sp" />

        <!-- "Also synced: Pixel 7": the group's other phones, from the mailbox's device list. -->
        <TextView
            android:id="@+id/computerAlsoSynced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/settings_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/unpair"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/unpair" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pairAgain"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/pair_again"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/syncNow"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/sync_now" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
