<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ux_logo_tile" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/header_tagline"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shown until a speech model is downloaded -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/modelBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/brand"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/speech_banner_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/speech_banner_body"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bannerDownload"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/white"
                    android:text="@string/speech_banner_title"
                    android:textColor="@color/brand_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Claude cleanup -->
        <include
            android:id="@+id/cardClaude"
            layout="@layout/section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Wirl.Card">
            <LinearLayout style="@style/Wirl_CardBody">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dictationCleanup"
                    style="@style/Wirl_Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dictation_cleanup_toggle" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/apiKeyLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/api_key_label"
                    app:endIconMode="password_toggle"
                    app:placeholderText="@string/api_key_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/apiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/apiKeyStatus"
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/style_notes_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/styleNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="2"
                        android:inputType="textMultiLine|textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/save" />

                <TextView
                    android:id="@+id/lastResult"
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dictation -->
        <include
            android:id="@+id/cardDictation"
            layout="@layout/section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Wirl.Card">
            <LinearLayout style="@style/Wirl_CardBody">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/micButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/testDictation"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/test_dictation" />

                <TextView
                    android:id="@+id/testResults"
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/dictation_language">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/dictationLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/packStatus"
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloadPack"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/download_speech_pack"
                    android:visibility="gone" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/silenceBeeps"
                    style="@style/Wirl_Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/silence_beeps_toggle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Speech engine -->
        <include
            android:id="@+id/cardSpeech"
            layout="@layout/section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Wirl.Card">
            <LinearLayout style="@style/Wirl_CardBody">

                <TextView
                    android:id="@+id/speechEngine"
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openVoiceSettings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/open_voice_settings"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/whisper_engine_title">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/engineChoice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/engineStatus"
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/modelFast"
                    layout="@layout/item_whisper_model" />

                <include
                    android:id="@+id/modelAccurate"
                    layout="@layout/item_whisper_model" />

                <include
                    android:id="@+id/modelMultilingual"
                    layout="@layout/item_whisper_model" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/mobileDataSwitch"
                    style="@style/Wirl_Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/allow_mobile_data_toggle" />

                <TextView
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/download_wifi_only" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bubble -->
        <include
            android:id="@+id/cardBubble"
            layout="@layout/section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Wirl.Card">
            <LinearLayout style="@style/Wirl_CardBody">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/bubbleToggle"
                    style="@style/Wirl_Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bubble_toggle" />

                <TextView
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bubble_toggle_summary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/doneCheckToggle"
                    style="@style/Wirl_Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/done_check_toggle" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/doneMessageToggle"
                    style="@style/Wirl_Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/done_message_toggle" />

                <TextView
                    android:id="@+id/bubbleSizeLabel"
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/bubbleSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="40"
                    android:valueTo="80"
                    android:stepSize="1" />

                <TextView
                    android:id="@+id/bubbleOpacityLabel"
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/bubbleOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="30"
                    android:valueTo="100"
                    android:stepSize="1" />

                <FrameLayout
                    android:id="@+id/bubblePreview"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/preview_well" />

                <TextView
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/accessibility_title" />

                <TextView
                    android:id="@+id/accessibilityStatus"
                    style="@style/Wirl_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openAccessibility"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_settings" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dictionary and setup -->
        <include
            android:id="@+id/cardDictionary"
            layout="@layout/section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Wirl.Card">
            <LinearLayout style="@style/Wirl_CardBody">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openDictionary"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openSetup"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/open_setup"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Developer options: off by default, and the Diagnostics button only shows when it's on -->
        <include
            android:id="@+id/cardDeveloper"
            layout="@layout/section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Wirl.Card">
            <LinearLayout style="@style/Wirl_CardBody">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/developerOptions"
                    style="@style/Wirl_Row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/developer_options_toggle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openDiagnostics"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/diagnostics_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetDefaults"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/reset_defaults" />
    </LinearLayout>
</ScrollView>
